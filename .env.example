# Another World Cluj — configurare pentru producție (cPanel).
# Copiați ca .env, completați valorile marcate și rulați: php artisan key:generate
# Cheile integrărilor (Stripe, SMS, Claude, ANAF) NU se pun aici: se introduc criptat în panou → Sistem → Integrări.

APP_NAME="Another World Cluj"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://anotherworldcluj.ro
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# Baza de date creată din cPanel → MySQL Databases (utilizatorul cu ALL PRIVILEGES pe această bază)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_aw
DB_USERNAME=cpaneluser_aw
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# E-mailurile de sistem pentru personal (resetare parolă, cod 2FA). Mesajele către clienți folosesc
# integrarea „E-mail” din panou; dacă aceea nu e configurată, nu se trimite nimic clienților.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.anotherworldcluj.ro
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@anotherworldcluj.ro
MAIL_FROM_NAME="${APP_NAME}"

# Limbile publice (ro implicit; „ro,en,hu” doar după verificarea traducerilor)
AW_PUBLIC_LOCALES=ro
# true pe subdomeniul de test: noindex + banner „Mediu de test”
AW_STAGING=false
# true = niciun mesaj real către clienți (doar către adresele de test de mai jos). În producție: false.
AW_MESSAGING_SANDBOX=false
AW_TEST_EMAILS=
AW_TEST_PHONES=

# Copii de siguranță: parolă pentru criptarea AES-256 a arhivelor (păstrați-o separat, în afara serverului!)
AW_BACKUP_PASSWORD=
# opțional: un disc Flysystem definit în config/filesystems.php pentru copie externă
AW_BACKUP_REMOTE_DISK=

# Asistent AI — modelul și efortul pot fi schimbate și din panou (Integrări → Asistent virtual)
AW_AI_MODEL=claude-opus-5-5
AW_AI_EFFORT=medium

VITE_APP_NAME="${APP_NAME}"
