; Copiați ca aw-fiscal-agent.ini și completați. Nu trimiteți acest fișier nimănui (conține secretul agentului).
AW_SERVER=https://anotherworldcluj.ro
AW_AGENT_KEY=
AW_AGENT_SECRET=
DRIVER=dry-run
; Daisy Compact M prin programul Fisco: DRIVER=fisco
FISCO_URL=http://127.0.0.1:4040
FISCO_NAME_MAX=36
FILE_OUT_DIR=
FILE_IN_DIR=
RESULT_TIMEOUT=90
POLL_SECONDS=3
